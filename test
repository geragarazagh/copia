#!/bin/zsh
# Off-screen tests (tests/main.swift says what each does). ./test runs unit, capture (a private pasteboard), copy
# (a private pasteboard), and with COPIA_RENDER=1 the renders (light, dark, purple accent, the leaving motion) into $TMPDIR/copia-render.
# ./test general writes to the general pasteboard, his content saved before and put back after: run it outside
# Claude's command sandbox. The binary stays at $TMPDIR/copia-tests.
# ./test vm runs the same (renders too) in the test machine pxl-27, plus the real-window checks (the Quick Look crash of 0.4, focus, keys, places:
# copia-tests screen; Return pasting into TextEdit for real: copia-tests pastelive), where the test windows never reach his screen; the
# renders come back into $TMPDIR/copia-render.
set -e
cd "${0:A:h}"
t=$TMPDIR/copia-tests
swiftc -O -target arm64-apple-macos13.0 -D TRIALS -o $t tests/main.swift app.swift capture.swift model.swift store.swift copy.swift \
  selection.swift panel.swift rows.swift text.swift motion.swift place.swift preview.swift menu.swift browser.swift views.swift settings.swift link.swift drag.swift queue.swift shelf.swift deck.swift keys.swift paste.swift
if [ "$1" = general ]; then $t general; exit; fi
if [ "$1" = vm ]; then
  # The real-window checks, paste into TextEdit and the renders, inside the test machine pxl-27 (macOS 27, his
  # 1728 x 1117 frame; started headless, no clipboard, no sound), so nothing reaches his screen. Replaced `./test cs`
  # 2026-11-21: the agents' session cs was deleted 2026-11-16. Lock ~/.local/share/tart/lock-pxl-27 while it runs.
  V=~/.local/share/holdq/test/vm; L=~/.local/share/tart/lock-pxl-27
  mkdir $L 2>/dev/null || { echo "pxl-27 is locked: $(cat $L/owner 2>/dev/null)"; exit 1; }; echo "copia ./test vm $(date)" > $L/owner
  trap '$V pxl-27 stop >/dev/null; rm -rf "${L:?}"' EXIT
  [ -d Copia.app ] || ./build >/dev/null
  $V pxl-27 boot
  d=$(mktemp -d); cp -R tests Copia.app $d/; cp -R ../mock/res $d/res; cp $t $d/copia-tests
  tar -C $d -cf - . | T=180 $V pxl-27 sh 'rm -rf clip && mkdir clip && tar -C clip -xf -'; rm -rf "${d:?}"
  T=900 $V pxl-27 sh 'cd clip && export COPIA_RES=$HOME/clip/res/ && ./copia-tests unit && ./copia-tests capture && ./copia-tests copy &&
    ./copia-tests screen && : > paste.txt && open -a TextEdit paste.txt && sleep 3 && ./copia-tests pastelive; r=$?; pkill -x TextEdit; [ $r = 0 ] &&
    rm -rf r && mkdir r && ./copia-tests render $HOME/clip/Copia.app light r/light.png && ./copia-tests render $HOME/clip/Copia.app dark r/dark.png motion &&
    ./copia-tests render $HOME/clip/Copia.app dark r/preview.png preview && ./copia-tests render $HOME/clip/Copia.app light r/keys.png keys' 2>&1 | grep -v sandbox_extension
  out=$TMPDIR/copia-render; rm -rf "${out:?}"; mkdir -p $out
  T=300 $V pxl-27 sh 'tar -C clip/r -cf - .' | tar -C $out -xf -; echo "renders: $out"; echo Done; exit
fi
$t unit
$t capture
$t copy
# Links with the network denied: a title or picture that needed a fetch would come back empty and fail.
sandbox-exec -p '(version 1)(allow default)(deny network*)' $t links
# The renders put a window under the desktop picture, which shows through his solid black wallpaper as a strange
# desktop (his recording 2026-11-21 08:52): only on a screen of its own, or with COPIA_RENDER=1 when he is away.
if [ "$COPIA_RENDER" != 1 ]; then echo "renders skipped (COPIA_RENDER=1 to run them: they show on the screen)"; echo Done; exit; fi
[ -d Copia.app ] || ./build >/dev/null
out=$TMPDIR/copia-render; rm -rf "$out"; mkdir -p "$out"
$t render $PWD/Copia.app light $out/light.png
$t render $PWD/Copia.app dark $out/dark.png motion
$t render $PWD/Copia.app dark $out/purple.png -AppleAccentColor 5
$t render $PWD/Copia.app light $out/few.png few
$t render $PWD/Copia.app dark $out/empty.png empty
$t render $PWD/Copia.app light $out/links.png links
$t render $PWD/Copia.app light $out/height.png height
$t render $PWD/Copia.app dark $out/preview.png preview
$t render $PWD/Copia.app light $out/image.png image
$t render $PWD/Copia.app light $out/keys.png keys
$t render $PWD/Copia.app dark $out/keysdark.png keys
echo "renders: $out"
echo Done
