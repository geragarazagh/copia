#!/bin/zsh
# Off-screen tests (tests/main.swift says what each does). ./test runs unit, capture (a private pasteboard), copy
# (a private pasteboard) and the renders (light, dark, purple accent, the leaving motion) into $TMPDIR/copia-render.
# ./test general writes to the general pasteboard, his content saved before and put back after: run it outside
# Claude's command sandbox. The binary stays at $TMPDIR/copia-tests.
# ./test cs runs the same (renders too) inside the agents' own login session (skill mac, control.md «cs»), where the
# test windows never reach his screen: binary, fixtures and pictures go to /Users/Shared/claude/clip first.
set -e
cd "${0:A:h}"
t=$TMPDIR/copia-tests
swiftc -O -target arm64-apple-macos13.0 -o $t tests/main.swift app.swift capture.swift model.swift store.swift copy.swift \
  selection.swift panel.swift rows.swift text.swift motion.swift place.swift preview.swift menu.swift browser.swift views.swift settings.swift link.swift drag.swift
if [ "$1" = general ]; then $t general; exit; fi
if [ "$1" = cs ]; then
  T=/Users/Shared/claude/clip; mkdir -p $T; chmod 777 $T
  [ -d Copia.app ] || ./build >/dev/null
  rm -rf $T/tests $T/res $T/Copia.app; cp -R tests Copia.app $T/; cp -R ../mock/res $T/res; cp $t $T/copia-tests; chmod -R a+rX $T/tests $T/Copia.app $T/res $T/copia-tests
  cs run /bin/zsh -c "cd $T && export COPIA_RES=$T/res/ && ./copia-tests unit && ./copia-tests capture && ./copia-tests copy &&
    sandbox-exec -p '(version 1)(allow default)(deny network*)' ./copia-tests links && rm -rf r && mkdir r &&
    ./copia-tests render $T/Copia.app light r/light.png -AppleLanguages '(ru)' && ./copia-tests render $T/Copia.app dark r/dark.png motion -AppleLanguages '(ru)' &&
    ./copia-tests render $T/Copia.app dark r/preview.png preview -AppleLanguages '(ru)' && chmod -R a+rX r"
  echo "renders: $T/r"; echo Done; exit
fi
$t unit
$t capture
$t copy
# Links with the network denied: a title or picture that needed a fetch would come back empty and fail.
sandbox-exec -p '(version 1)(allow default)(deny network*)' $t links
[ -d Copia.app ] || ./build >/dev/null
out=$TMPDIR/copia-render; rm -rf "$out"; mkdir -p "$out"
$t render $PWD/Copia.app light $out/light.png -AppleLanguages '(ru)'
$t render $PWD/Copia.app dark $out/dark.png motion -AppleLanguages '(ru)'
$t render $PWD/Copia.app dark $out/purple.png -AppleLanguages '(ru)' -AppleAccentColor 5
$t render $PWD/Copia.app light $out/en.png -AppleLanguages '(en)'
$t render $PWD/Copia.app light $out/uk.png -AppleLanguages '(uk)'
$t render $PWD/Copia.app light $out/few.png few -AppleLanguages '(ru)'
$t render $PWD/Copia.app dark $out/empty.png empty -AppleLanguages '(ru)'
$t render $PWD/Copia.app light $out/links.png links -AppleLanguages '(ru)'
$t render $PWD/Copia.app light $out/height.png height -AppleLanguages '(ru)'
$t render $PWD/Copia.app dark $out/preview.png preview -AppleLanguages '(ru)'
$t render $PWD/Copia.app light $out/image.png image -AppleLanguages '(ru)'
echo "renders: $out"
echo Done
