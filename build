#!/bin/zsh
# Builds <Name>.app in this folder with plain swiftc, no Xcode project (dev/apps.md, «Common to every app»).
# Needs Xcode 26 or later in /Applications for the icon (actool, Icon Composer).
# The app's name is set here only; the code reads it from the bundle. Version 0: no updater yet.
# SIGN_ID="Developer ID Application: …" ./build signs with that certificate (as the other apps' release does); ad hoc
# otherwise.
set -e
cd "${0:A:h}"
name=Copia min=13.0
id=com.geragaraza.${(L)name} app=$name.app
tmp=$(mktemp -d); trap 'rm -rf $tmp' EXIT
rm -rf "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"

# An explicit minimum: by default swiftc targets this Mac's macOS and every older system refuses the result.
swiftc -O -target arm64-apple-macos$min -o "$app/Contents/MacOS/$name" \
  main.swift app.swift capture.swift model.swift store.swift copy.swift selection.swift panel.swift rows.swift text.swift motion.swift place.swift preview.swift menu.swift browser.swift views.swift settings.swift link.swift

# App icon, Apple's way (apps.md, «Icons»): the picture from icon.swift, the plate is the system's own fill, compiled
# by Xcode's actool into Assets.car (macOS 26+ switch it with the theme) and AppIcon.icns (Apple's light rendition, 13-15).
# Glass, group shadow and translucency off: with Icon Composer's defaults the picture turns to glass.
# The light picture sits in the specializations list as the entry without an appearance: given as plain image-name,
# Icon Composer ignores the dark entry and darkens the light picture itself.
# icon.swift is the one file to swap for a new icon: the app, docs/icon.png and docs/icon-dark.png (the README's, Icon
# Composer's own renders, 206 px on a 256 canvas as Apple's 824 of 1024) all come from it here. Its layer is SVG, not
# the family's PNG pair: actool keeps it as a vector, every size drawn from the path.
xc=/Applications/Xcode.app/Contents
swiftc -O -o $tmp/icon icon.swift
mkdir -p $tmp/AppIcon.icon/Assets
$tmp/icon $tmp/AppIcon.icon/Assets
cat > $tmp/AppIcon.icon/icon.json <<'JSON'
{
  "fill" : "system-light",
  "fill-specializations" : [ { "appearance" : "dark", "value" : "system-dark" } ],
  "groups" : [ { "layers" : [ { "name" : "picture", "glass" : false,
    "image-name-specializations" : [ { "value" : "light.svg" }, { "appearance" : "dark", "value" : "dark.svg" } ] } ],
    "shadow" : { "kind" : "none", "opacity" : 0.5 }, "translucency" : { "enabled" : false, "value" : 0.5 } } ],
  "supported-platforms" : { "squares" : [ "macOS" ] }
}
JSON
DEVELOPER_DIR=$xc/Developer xcrun actool $tmp/AppIcon.icon --compile "$PWD/$app/Contents/Resources" --platform macosx \
  --minimum-deployment-target $min --app-icon AppIcon --output-partial-info-plist $tmp/icon.plist --target-device mac >/dev/null
mkdir -p docs
for r in Default Dark; do
  "$xc/Applications/Icon Composer.app/Contents/Executables/ictool" $tmp/AppIcon.icon --export-image --output-file $tmp/$r.png \
    --platform macOS --rendition $r --width 206 --height 206 --scale 1 >/dev/null
  sips -p 256 256 $tmp/$r.png --out docs/icon${${r:#Default}:+-dark}.png >/dev/null
done

cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>$id</string>
<key>CFBundleName</key><string>$name</string>
<key>CFBundleDisplayName</key><string>$name</string>
<key>CFBundleExecutable</key><string>$name</string>
<key>CFBundleIconFile</key><string>AppIcon</string>
<key>CFBundleIconName</key><string>AppIcon</string>
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleLocalizations</key><array><string>en</string><string>ru</string><string>uk</string></array>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0</string>
<key>CFBundleVersion</key><string>0</string>
<key>LSUIElement</key><true/>
<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
<key>LSMinimumSystemVersion</key><string>$min</string>
</dict></plist>
PLIST

for l in ru uk; do
  mkdir "$app/Contents/Resources/$l.lproj"
  cp lang/$l.strings "$app/Contents/Resources/$l.lproj/Localizable.strings"
done
mkdir "$app/Contents/Resources/en.lproj"   # English is the text in the code

# Hardened runtime, no entitlements: the app reads the clipboard and draws a panel, nothing that needs one.
sign=${SIGN_ID:--}; stamp=(); [ "$sign" = - ] || stamp=(--timestamp)
codesign -f -s "$sign" $stamp --options runtime --identifier $id "$app"
echo Done
